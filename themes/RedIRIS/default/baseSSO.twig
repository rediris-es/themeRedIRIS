{% apply spaceless %}
<!DOCTYPE html>
<html lang="{{ currentLanguage }}" dir="{{ isRTL ? 'rtl' : 'ltr' }}">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="robots" content="noindex, nofollow">

    <title>{{ pagetitle }}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/icons/favicon.ico', 'themeRedIRIS') }}"/>
    
      
    {{ include('_head.twig', ignore_missing = true) }}
    {% block preload %}{% endblock %}

    <link rel="stylesheet" type="text/css" href="{{ asset('css/bootstrap.min.css', 'themeRedIRIS') }}">
    <script src="{{ asset('js/bootstrap.bundle.min.js', 'themeRedIRIS') }}"></script>
    
    <link rel="stylesheet" type="text/css" href="{{ asset('css/main.css', 'themeRedIRIS') }}">
  </head>


  <body id="{{ templateId }}">
    <div id="bg-fondo"></div>
      <div class="row m-0 p-0">
        {% block content %}{% endblock %}
      </div>

    <div id="imageData" data-images="{% for fondo in fondos %}{{ asset('images/fondos/'~ fondo ,'themeRedIRIS') }},{% endfor %}"></div>
    
    <script src="{{ asset('js/RedIRIS_slider.js', 'themeRedIRIS') }}"></script>
    
    {% block postload %}{% endblock %}
  </body>

</html>
{% endapply %}
